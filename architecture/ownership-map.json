    {
      "path": "audit/architecture/check_forbidden_patterns.mjs",
      "owner": "architecture-check-forbidden-patterns",
      "responsibility": "Check forbidden text patterns only.",
      "maxLines": 45,
      "maxDecisionPoints": 16,
      "forbiddenPatterns": [
        "process.exit",
        "console.log",
        "runOwnershipGuard"
      ],
      "requiredPatterns": [
        "export function checkForbiddenPatterns",
