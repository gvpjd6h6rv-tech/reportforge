{
  "schema": "rf-architecture-ownership/v1",
  "policy": {
    "oneFileOneResponsibility": true,
    "oneOwnerPerFile": true,
    "oneGuardOneRule": true,
    "noDebugCenterEngineInsideUi": true
  },
  "rules": [
    {
      "path": "tools/rf-debug-center/rf-debug-center-api.js",
      "owner": "debug-center-api",
      "responsibility": "Public Debug Center API and module wiring only.",
      "maxLines": 310,
      "maxDecisionPoints": 95,
      "forbiddenPatterns": [
        "./visual-doctor/",
        "runRfVisualDoctor",
        "simulateCssFixInDom",
        "buildSafeCssSimulationPlan",
        "function refreshVisualDoctorModel",
        "function runVisualDoctorRuntimePreview"
      ],
      "requiredPatterns": [
        "applyVisualDoctorApi(api, state, applyModel)",
        "decorateVisualDoctorModel(state.lastModel, state)"
      ]
    },
    {
      "path": "tools/rf-debug-center/visual-doctor",
      "owner": "visual-doctor-core",
      "responsibility": "Pure Visual Doctor engine modules.",
      "maxLinesPerFile": 280,
      "maxDecisionPointsPerFile": 105,
      "forbiddenPatterns": [
        "rf-debug-center-api",
        "rf-debug-center-detached-window",
        "window.open",
        "document.write",
        "fetch(",
        "XMLHttpRequest"
      ],
      "requiredFiles": [
        "visual_doctor_registry.js",
        "visual_fix_simulator.js",
        "visual_forensic_bundle.js",
        "visual_lab_artifact_contract.js"
      ]
    },
    {
      "path": "audit/architecture/load_ownership_map.mjs",
      "owner": "architecture-map-loader",
      "responsibility": "Load and validate ownership-map schema only.",
      "maxLines": 35,
      "maxDecisionPoints": 8,
      "forbiddenPatterns": [
        "process.exit",
        "console.log",
        "runOwnershipGuard"
      ],
      "requiredPatterns": [
        "export function loadOwnershipMap",
        "rf-architecture-ownership/v1"
      ]
    },
    {
      "path": "audit/architecture/list_js_files.mjs",
      "owner": "architecture-target-expander",
      "responsibility": "Expand one file or directory path into JS file targets only.",
      "maxLines": 35,
      "maxDecisionPoints": 8,
      "forbiddenPatterns": [
        "process.exit",
        "console.log",
        "runOwnershipGuard"
      ],
      "requiredPatterns": [
        "export function listJsFiles"
      ]
    },
    {
      "path": "audit/architecture/count_lines.mjs",
      "owner": "architecture-line-counter",
      "responsibility": "Count text lines only.",
      "maxLines": 20,
      "maxDecisionPoints": 4,
      "forbiddenPatterns": [
        "fs.",
        "process.exit",
        "console.log",
        "runOwnershipGuard"
      ],
      "requiredPatterns": [
        "export function countLines"
      ]
    },
    {
      "path": "audit/architecture/count_decision_points.mjs",
      "owner": "architecture-decision-counter",
      "responsibility": "Count approximate decision points only.",
      "maxLines": 25,
      "maxDecisionPoints": 14,
      "forbiddenPatterns": [
        "fs.readFileSync",
        "process.exit",
        "console.log",
        "runOwnershipGuard"
      ],
      "requiredPatterns": [
        "export function countDecisionPoints"
      ]
    },
    {
      "path": "audit/architecture/check_max_lines.mjs",
      "owner": "architecture-check-max-lines",
      "responsibility": "Check line budget only.",
      "maxLines": 45,
      "maxDecisionPoints": 14,
      "forbiddenPatterns": [
        "process.exit",
        "console.log",
        "runOwnershipGuard"
      ],
      "requiredPatterns": [
