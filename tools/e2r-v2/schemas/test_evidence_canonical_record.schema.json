{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E2R v2 canonical test evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "productionFile",
    "sourcePath",
    "evidenceStrength",
    "outcome"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "productionFile": {
      "type": "string",
      "minLength": 1
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1
    },
    "evidenceStrength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "outcome": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    }
  }
}
